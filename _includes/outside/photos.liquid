{%- comment -%}
  Photos on /outside/, from _data/outside/photos.yml.

  part="hero":    the full-width photo that opens the page
  part="lightbox": the lightbox <dialog> the hero opens in

  Only the hero is shown; the rest of the photography lives on Flickr (linked
  from the Cameras section). Without JavaScript the hero is a plain link to
  the full-size file.
{%- endcomment -%}
{%- assign photos = site.data.outside.photos -%}
{%- assign hero = null -%}
{%- for p in photos -%}
  {%- if p.hero and hero == null -%}{%- assign hero = p -%}{%- endif -%}
{%- endfor -%}
{%- if hero == null -%}{%- assign hero = photos | first -%}{%- endif -%}

{% if include.part == 'hero' %}
  {% if hero %}
    <div class="outside-lead" id="photos">
      <figure>
        <a class="photo-link" href="{{ hero.src | relative_url }}" data-lightbox data-caption="{{ hero.caption | escape }}">
          {% include outside/picture.liquid path=hero.src alt=hero.alt width=hero.width height=hero.height sizes="(min-width: 930px) 900px, 95vw" loading="eager" %}
        </a>
        {% if hero.caption %}
          <figcaption class="caption">{{ hero.caption }}</figcaption>
        {% endif %}
      </figure>
    </div>
  {% elsif jekyll.environment == 'development' %}
    <div class="outside-lead" id="photos">
      <p class="outside-placeholder">Placeholder — add a photo with hero: true in _data/outside/photos.yml</p>
    </div>
  {% endif %}
{% elsif include.part == 'lightbox' %}
  <dialog class="lightbox" aria-label="Photo viewer" data-lightbox-dialog>
    <figure class="lightbox-figure">
      <img class="lightbox-img" src="data:," alt="">
      <figcaption class="lightbox-caption"></figcaption>
    </figure>
    <p class="lightbox-count" aria-live="polite"></p>
    <button type="button" class="lightbox-btn lightbox-prev" aria-label="Previous photo">&#8249;</button>
    <button type="button" class="lightbox-btn lightbox-next" aria-label="Next photo">&#8250;</button>
    <button type="button" class="lightbox-btn lightbox-close" aria-label="Close photo viewer">&times;</button>
  </dialog>
{% endif %}
