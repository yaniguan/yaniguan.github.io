{% assign repo_parts = include.repository | split: '/' %}
{% assign repo_name = repo_parts[1] %}
{% assign repo_owner = repo_parts[0] %}

<div class="repo p-2">
  <a href="https://github.com/{{ include.repository }}" target="_blank" style="text-decoration: none;">
    <div
      class="card h-100"
      style="border: 1px solid var(--global-divider-color, #e0e0e0); border-radius: 8px; padding: 1rem; transition: box-shadow 0.2s;"
    >
      <div class="d-flex align-items-center gap-2 mb-1">
        <i class="fab fa-github" style="font-size: 1.1rem; color: var(--global-text-color, #333);"></i>
        <span style="font-weight: 600; font-size: 0.95rem; color: var(--global-theme-color, #6C63FF);">{{ repo_name }}</span>
      </div>
    </div>
  </a>
</div>
