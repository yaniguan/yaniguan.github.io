---
layout: default
---
{% comment %}
  A single short write-up. Deliberately thinner than the blog `post` layout: no
  tag chips, no comments, no related-post grid — just the piece and a way back.
{% endcomment %}
<div class="post about-page">
  <header class="page-head">
    <p class="page-eyebrow"><a href="{{ '/notes/' | relative_url }}">Notes</a></p>
    <h1 class="page-title">{{ page.title }}</h1>
    {% assign minutes = content | strip_html | number_of_words | divided_by: 200 | plus: 1 %}
    <p class="page-meta">
      {{ page.date | date: '%B %-d, %Y' }} · {{ minutes }} min read
      {%- if page.description %} · {{ page.description }}{% endif -%}
    </p>
    {% if page.tags.size > 0 %}
      <p class="note-tags">
        {% for tag in page.tags -%}
          <span class="note-tag">{{ tag }}</span>
        {%- endfor %}
      </p>
    {% endif %}
  </header>

  <article class="about-body note-body">{{ content }}</article>

  <nav class="note-pager" aria-label="More notes">
    {% if page.previous %}
      <a class="note-pager-prev" href="{{ page.previous.url | relative_url }}">
        <span>{{ page.previous.date | date: '%b %Y' }}</span>{{ page.previous.title }}
      </a>
    {% endif %}
    {% if page.next %}
      <a class="note-pager-next" href="{{ page.next.url | relative_url }}">
        <span>{{ page.next.date | date: '%b %Y' }}</span>{{ page.next.title }}
      </a>
    {% endif %}
  </nav>

  <p class="about-more" style="margin-top: 2.5rem">
    <a href="{{ '/notes/' | relative_url }}">All notes</a>
  </p>
</div>
