---
layout: default
---
<div class="post about-page">
  <!-- Hero: name, affiliation, tagline, links, portrait -->
  <header class="about-hero">
    <div class="about-hero-main">
      <h1 class="about-name">
        {% if site.first_name or site.last_name %}
          {{ site.first_name -}}
          {%- if site.middle_name != blank %} {{ site.middle_name }}{% endif %}
          {{ site.last_name }}
        {% else %}
          {{ site.title }}
        {% endif %}
      </h1>

      {% if page.subtitle %}
        <p class="about-affiliation">{{ page.subtitle }}</p>
      {% endif %}

      {% if page.tagline %}
        <p class="about-tagline">{{ page.tagline }}</p>
      {% endif %}

      <nav class="about-links" aria-label="Profile links">
        {% if site.data.socials.email %}
          <a href="mailto:{{ site.data.socials.email | encode_email }}">Email</a>
        {% endif %}
        {% if site.data.socials.scholar_userid %}
          <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}">Google&nbsp;Scholar</a>
        {% endif %}
        {% if site.data.socials.github_username %}
          <a href="https://github.com/{{ site.data.socials.github_username }}">GitHub</a>
        {% endif %}
        {% if site.data.socials.linkedin_username %}
          <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}">LinkedIn</a>
        {% endif %}
        <a href="{{ '/cv/' | relative_url }}">CV</a>
      </nav>
    </div>

    {% if page.profile and page.profile.image %}
      <div class="about-portrait">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {% if page.profile.image_circular %}
          {% assign profile_image_class = 'img-fluid rounded-circle' %}
        {% else %}
          {% assign profile_image_class = 'img-fluid' %}
        {% endif %}
        {%
          include figure.liquid loading="eager" path=profile_image_path class=profile_image_class
          sizes="(min-width: 768px) 224px, 140px" alt=page.profile.image cache_bust=true
        %}
        {% if page.profile.more_info %}
          <div class="about-portrait-note">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}
  </header>

  <article class="about-body">
    {{ content }}

    <!-- Selected publications -->
    {% if page.selected_papers %}
      <section class="about-section">
        <h2 class="about-section-title">Selected publications</h2>
        {% include selected_papers.liquid %}
        <p class="about-more">
          <a href="{{ '/publications/' | relative_url }}">All publications</a>
        </p>
      </section>
    {% endif %}

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <section class="about-section">
        <h2 class="about-section-title">News</h2>
        {% include news.liquid limit=true %}
        <p class="about-more">
          <a href="{{ '/news/' | relative_url }}">All news</a>
        </p>
      </section>
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <section class="about-section">
        <h2 class="about-section-title">Latest posts</h2>
        {% include latest_posts.liquid %}
        <p class="about-more">
          <a href="{{ '/blog/' | relative_url }}">All posts</a>
        </p>
      </section>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
